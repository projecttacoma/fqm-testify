{
  "name": "fqm-testify",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "check": "npm run test && npm run lint && npm run prettier",
    "dev": "next dev",
    "build": "next build",
    "build:names": "ts-node scripts/generatePatientNames.ts && prettier --write data/names.ts --loglevel silent",
    "upload:qicore-profiles": "ts-node --project tsconfig.scripts.json scripts/uploadQicoreProfiles.ts",
    "start": "npx serve@latest out",
    "lint": "eslint pages util components state __tests__ scripts --ext .js,.jsx,.ts,.tsx && tsc --noEmit",
    "lint:fix": "eslint pages util components state __tests__ scripts --ext .js,.jsx,.ts,.tsx --fix",
    "prettier": "prettier --check \"**/*.{js,ts,jsx,tsx,css}\"",
    "prettier:fix": "prettier --write \"**/*.{js,ts,jsx,tsx,css}\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.5",
    "@emotion/react": "^11.11.0",
    "@emotion/server": "^11.11.0",
    "@mantine/core": "^6.0.11",
    "@mantine/dates": "^6.0.11",
    "@mantine/dropzone": "^6.0.11",
    "@mantine/hooks": "^6.0.11",
    "@mantine/next": "^6.0.11",
    "@mantine/notifications": "^6.0.11",
    "@tabler/icons": "^1.105.0",
    "@tabler/icons-react": "^3.41.1",
    "@uiw/react-codemirror": "^4.7.0",
    "dayjs": "^1.11.7",
    "fhir-spec-tools": "^0.5.0",
    "fhirpath": "^2.14.6",
    "file-saver": "^2.0.5",
    "fqm-execution": "^1.8.3",
    "html-react-parser": "^6.0.1",
    "immer": "^11.1.4",
    "jszip": "^3.10.0",
    "luxon": "^2.5.2",
    "next": "^16.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recoil": "^0.7.3-alpha.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^7.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^16.3.2",
    "@types/fhir": "0.0.34",
    "@types/file-saver": "^2.0.5",
    "@types/lodash": "^4.14.182",
    "@types/luxon": "^2.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "18.0.9",
    "@types/react-dom": "18.0.4",
    "@types/uuid": "^8.3.4",
    "@types/xml2js": "^0.4.11",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.9",
    "eslint-config-prettier": "^8.5.0",
    "jest": "^28.1.0",
    "jest-environment-jsdom": "^30.3.0",
    "prettier": "^2.6.2",
    "ts-node": "^10.8.1",
    "typescript": "5.7.3",
    "xml2js": "^0.5.0"
  }
}
